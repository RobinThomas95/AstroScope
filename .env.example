# ---- AstroScope environment ----
# Copy to .env (repo root) and fill in. The backend loads this file on start-up.

# NASA ADS API token (Module 5). https://ui.adsabs.harvard.edu/user/settings/token
ADS_DEV_KEY=

# LLM provider for the synthesis engine (Module 6). Set one of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Backend server
ASTROSCOPE_HOST=0.0.0.0
ASTROSCOPE_PORT=8000
# Comma-separated list of origins allowed to call the API (the Vite dev server by default).
ASTROSCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Remote-service timeouts (seconds) and cache TTL (seconds) for resolver results.
ASTROSCOPE_REMOTE_TIMEOUT=20
ASTROSCOPE_CACHE_TTL=3600

# Service endpoints (defaults are the CDS production services).
ASTROSCOPE_SIMBAD_TAP_URL=https://simbad.cds.unistra.fr/simbad/sim-tap
ASTROSCOPE_MOCSERVER_URL=https://alasky.cds.unistra.fr/MocServer/query
# MAST TAP endpoint is auto-detected; set this to force one.
ASTROSCOPE_MAST_TAP_URL=

# Frontend: where the API lives (only needed when not using the Vite dev proxy).
VITE_API_BASE_URL=
