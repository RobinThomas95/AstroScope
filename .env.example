# ---- AstroScope environment ----
# Copy to .env (repo root) and fill in. The backend loads this file on start-up.

# Optional server-side defaults for API keys. Users can instead paste their own keys in the
# app's Keys dialog (kept in their browser, sent per request, never stored on the server).
# NASA ADS API token (Literature tab). Free: https://ui.adsabs.harvard.edu/user/settings/token
ADS_DEV_KEY=
# Google Gemini API key (Synthesis). Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=auto   # or a model name from /api/llm/models

# Backend server
ASTROSCOPE_HOST=0.0.0.0
ASTROSCOPE_PORT=8000
# Comma-separated list of origins allowed to call the API (the Vite dev server by default).
ASTROSCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Remote-service timeouts (seconds) and cache TTL (seconds) for resolver results.
ASTROSCOPE_REMOTE_TIMEOUT=45
ASTROSCOPE_CACHE_TTL=3600

# Service endpoints (defaults are the CDS production services).
ASTROSCOPE_SIMBAD_TAP_URL=https://simbad.cds.unistra.fr/simbad/sim-tap
ASTROSCOPE_MOCSERVER_URL=https://alasky.cds.unistra.fr/MocServer/query
# MAST TAP endpoint is auto-detected; set this to force one.
ASTROSCOPE_MAST_TAP_URL=

# Largest ALMA cube product (MB) the backend will download for spectrum extraction when the
# request does not say otherwise (the app passes the product's own size).
ASTROSCOPE_CUBE_MAX_MB=600
# Where downloaded ALMA cubes are kept (default: <system temp>/astroscope-cubes) and the size
# beyond which the oldest are deleted. "clear" in the Spectrum tab empties it.
ASTROSCOPE_CUBE_CACHE_DIR=
ASTROSCOPE_CUBE_CACHE_GB=4

# Frontend: where the API lives (only needed when not using the Vite dev proxy).
VITE_API_BASE_URL=
